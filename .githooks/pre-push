#!/bin/sh
# 검사를 안 지난 것은 푸시되지 않는다 — 푸시가 곧 배포다.
# git 은 pre-push 의 stdin 으로 밀어 올릴 ref 목록을 넘긴다. 그걸 읽어 비우지 않으면
# 검사가 띄우는 크롬이 그 stdin 을 물고 늘어져 영영 안 끝난다 (십 분을 두 번 날렸다).
# 먼저 비우고, 아래로는 /dev/null 을 물린다.
cat > /dev/null
echo "── 푸시 전 전체 검증 (1분쯤 걸린다)"
npm run verify < /dev/null || {
  echo ""
  echo "  푸시를 멈춘다. 푸시하면 그대로 배포되므로 깨진 채로 내보낼 수 없다."
  echo "  정말 넘겨야 한다면 git push --no-verify (권하지 않는다)"
  exit 1
}
exit 0
