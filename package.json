{
  "name": "mana-tower",
  "version": "1.0.0",
  "description": "Tower of Infinity — an idle game that never ends",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
